# Local development uses persistent embedded PostgreSQL in .data/.
# Production requires a managed PostgreSQL database and a random 32+ character secret.
DATABASE_URL=
SESSION_SECRET=
APP_URL=http://localhost:3000
BARCHIN_API_KEY=
# No live financial transactions or store publishing are enabled in this milestone.

# Store import & synchronization
# Production: generate once with `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# Back up this key securely; changing it makes existing encrypted connections unreadable.
CONNECTOR_ENCRYPTION_KEY=
# Required in production: exact, comma-separated merchant API hostnames approved by the operator.
# Also include your authorized discovery service host if configured below.
CONNECTOR_ALLOWED_HOSTS=
# Default true. Local embedded PostgreSQL must use the in-app worker only.
IMPORT_WORKER_ENABLED=true
# Optional authorized discovery endpoint. See docs/STORE-SYNC.md for the JSON contract.
# Without it imported products stay in awaiting_source; Torob is never scraped implicitly.
DISCOVERY_API_URL=
DISCOVERY_API_TOKEN=

TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=
# Seconds between scraper actions; minimum 3
REQUEST_DELAY=5
DATA_DIR=data
# Set only after checking Torob's terms/permission; robots.txt disallows /search/.
SEARCH_PERMISSION_CONFIRMED=false
# Optional local browser executable; leave empty on macOS
CHROMIUM_PATH=
RESOLVE_BUY_LINKS=true
